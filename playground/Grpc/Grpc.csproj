<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Lite.Serialization.Protobuf.Generated</InterceptorsNamespaces>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Lite.Serialization.Protobuf.Generated</InterceptorsPreviewNamespaces>
  </PropertyGroup>

  <!-- Grpc.AspNetCore.Server is the runtime only — no Grpc.Tools, no Google.Protobuf.
       The whole point: gRPC.NET without the Google serializer. -->
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore.Server" Version="2.71.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sources\Lite.Serialization.Protobuf\Lite.Serialization.Protobuf.csproj" />
    <ProjectReference
      Include="..\..\sources\Lite.Serialization.Protobuf.SourceGenerator\Lite.Serialization.Protobuf.SourceGenerator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
