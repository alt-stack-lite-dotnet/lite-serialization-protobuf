<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lite-proto</ToolCommandName>

    <PackageId>Lite.Serialization.Protobuf.Cli</PackageId>
    <Version>1.0.0-alpha</Version>
    <PackageVersion>1.0.0-alpha</PackageVersion>
    <Description>CLI for Lite.Serialization.Protobuf: export .proto schemas from built assemblies, import .proto into C# types.</Description>
    <PackageTags>protobuf;codegen;cli;dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
    <PackageReference Include="protobuf-net.Reflection" Version="3.2.45" />
  </ItemGroup>
</Project>
