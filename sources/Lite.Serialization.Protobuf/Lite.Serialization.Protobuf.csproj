<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>

    <PackageId>Lite.Serialization.Protobuf</PackageId>
    <Version>1.0.0-alpha</Version>
    <PackageVersion>1.0.0-alpha</PackageVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>grpc;protobuf;serialization;source-generator;interceptors</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Core.Api" Version="2.71.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\Lite.Serialization.Protobuf.SourceGenerator\Lite.Serialization.Protobuf.SourceGenerator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
